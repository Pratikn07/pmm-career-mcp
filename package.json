{
  "name": "pmm-career-mcp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:consent && npm run build:review-card && npm run build:founder-export-card",
    "build:server": "tsc -p tsconfig.json",
    "build:consent": "node scripts/build-consent-client.mjs",
    "build:review-card": "node scripts/build-review-card.mjs",
    "build:founder-export-card": "node scripts/build-founder-export-card.mjs",
    "pretest": "npm run build",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "smoke:supabase": "tsx scripts/smoke-supabase.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:oauth-token": "tsx scripts/verify-oauth-token.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "2.110.7",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "jszip": "3.10.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "nock": "^14.0.16",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
