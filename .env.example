# Example names and placeholders only. Never put real credentials in this file,
# source control, ChatGPT, or a browser. Configure production values in Railway.

# Host configuration — public service settings (not credentials).
NODE_ENV=production
PORT=3000
BASE_URL=https://<railway-service-domain>
AUTH_MODE=oauth

# Supabase browser configuration — public by design; it is served to the consent page.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# OAuth validation — host-only configuration, but not browser credentials.
# Derive OIDC_ISSUER by appending /auth/v1 to SUPABASE_URL.
OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Must be exactly the same canonical URL as BASE_URL (no trailing slash).
OIDC_AUDIENCE=https://<railway-service-domain>
ALLOWED_SUBJECT=<single-supabase-auth-user-uuid>

# Secrets — host-only. Use Railway's secret environment variables; never use real values here.
DATABASE_URL=postgresql://<database-user>:<database-password>@<project-ref>.pooler.supabase.com:5432/postgres
TOKEN_ENCRYPTION_KEY=<64-hex-character-secret>
LINKEDIN_CLIENT_ID=<linkedin-client-id-when-configured-later>
LINKEDIN_CLIENT_SECRET=<linkedin-client-secret-when-configured-later>
LINKEDIN_REDIRECT_URI=https://<railway-service-domain>/linkedin/callback

# LinkedIn remains a later, manually configured phase. Keep publishing disabled.
LINKEDIN_VERSION=202606
LINKEDIN_PUBLISH_ENABLED=false
