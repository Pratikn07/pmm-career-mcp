# Copyable local-development defaults. A local PostgreSQL server must be
# available at DATABASE_URL before `npm run dev` can start. Never put real
# credentials in this file, source control, ChatGPT, or a browser.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Local development may reuse the same role. Production requires a distinct
# migration owner URL and a least-privilege runtime DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
BASE_URL=http://127.0.0.1:3000
AUTH_MODE=none
LINKEDIN_VERSION=202606
# Master gate for every LinkedIn post. Enabling it never bypasses the app-only
# exact preview and explicit human confirmation.
LINKEDIN_PUBLISH_ENABLED=false
# Independent image-upload/publish gate. Image posts require both switches;
# text-only posts still require the master gate and app-only exact preview.
LINKEDIN_IMAGE_PUBLISH_ENABLED=false
# Create this bucket privately with a 20 MiB limit and only image/jpeg,
# image/png, and image/gif. Never add a service-role or secret key.
LINKEDIN_MEDIA_BUCKET=linkedin-draft-media

# Production reference — copy these names into Railway environment settings,
# replacing every placeholder there. Do not uncomment them in this local file.
# Public configuration: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, and BASE_URL.
# BASE_URL is public configuration, but the consent page exposes only the two
# Supabase values below.
# NODE_ENV=production
# BASE_URL=https://<railway-service-domain>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
#
# Host-only, non-secret configuration.
# AUTH_MODE=oauth
# Derive OIDC_ISSUER by appending /auth/v1 to SUPABASE_URL.
# OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
# OIDC_AUDIENCE=https://<railway-service-domain>
# ALLOWED_SUBJECT=<single-supabase-auth-user-uuid>
# Download the project CA from Supabase Database Settings -> SSL Configuration
# and store its complete PEM text in this Railway variable.
# DATABASE_CA_CERT=<supabase-project-ca-pem>
# LINKEDIN_REDIRECT_URI=https://<railway-service-domain>/linkedin/callback
# Leave LINKEDIN_REDIRECT_URI unset until the later LinkedIn authorization phase.
#
# Secrets: host-only Railway secret environment variables; never use real values here.
# Copy the exact Session Pooler host from Supabase Dashboard -> Connect. Shared
# pooler usernames are <database-role>.<project-ref>. Percent-encode passwords
# before placing them in a URL (for example, @ becomes %40).
# DATABASE_URL=postgresql://career_mcp_runtime.<project-ref>:<percent-encoded-runtime-password>@aws-<region>.pooler.supabase.com:5432/postgres
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<percent-encoded-owner-password>@aws-<region>.pooler.supabase.com:5432/postgres
# TOKEN_ENCRYPTION_KEY=<64-hex-character-secret>
# LINKEDIN_CLIENT_ID=<linkedin-client-id-when-configured-later>
# LINKEDIN_CLIENT_SECRET=<linkedin-client-secret-when-configured-later>
